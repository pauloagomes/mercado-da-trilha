# Copie para .env e preencha.
DOMINIO=mercado.seudominio.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Para onde os links "Conheça o Trilha HUB" levam (o jogo acrescenta os parâmetros UTM).
TRILHAHUB_URL=https://trilhahub.cloud
# 1 em produção (HTTPS). Use 0 só para testar sem HTTPS.
COOKIE_SECURE=1
LOG_LEVEL=info
# Envio do código ao e-mail do responsável (smtps://usuario:senha@servidor:465; senha com caracteres especiais vai codificada em URL).
SMTP_URL=
EMAIL_DE=Mercado da Trilha <nao-responda@seudominio.com.br>
# Segredo do código de recuperação (openssl rand -hex 32).
SEGREDO_RECUPERACAO=
