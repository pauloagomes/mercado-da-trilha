# Gerado pelo nginx a partir deste modelo (troca ${DOMINIO} pelo valor do .env).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Registros de acesso (Marco Civil da Internet, art. 15): IP, data e hora de cada acesso, num arquivo
# por dia em /var/log/nginx/acesso. O serviço "registros" do docker-compose apaga os de mais de 6 meses.
map $time_iso8601 $dia_registro { "~^(?<d>\d{4}-\d{2}-\d{2})" $d; default "sem-data"; }
access_log /var/log/nginx/acesso/acesso-$dia_registro.log combined;
open_log_file_cache max=4 inactive=1m;
# Com variável no nome do arquivo, o nginx só grava se a pasta raiz da requisição existir: esta vale
# também para o servidor da porta 80, que só redireciona.
root /usr/share/nginx/html;

server {
  listen 80;
  server_name ${DOMINIO};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMINIO};

  ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss://${DOMINIO}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  gzip on;
  gzip_types text/css application/javascript image/svg+xml application/json;

  root /usr/share/nginx/html;
  # HTML, JS e CSS: "expires -1" manda Cache-Control: no-cache, e o navegador confere a versão (ETag) a cada
  # carga, para nunca misturar tela velha com servidor novo. Imagens ficam um dia. (Não use add_header aqui:
  # ele faria esta location perder os cabeçalhos de segurança do bloco server.)
  location / { try_files $uri $uri/ /index.html; expires -1; }
  location /img/ { expires 1d; }

  location /api/ { proxy_pass http://app:3000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
  location /r/   { proxy_pass http://app:3000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
  location /ws {
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
  }
}
